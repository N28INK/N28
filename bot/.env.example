# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el archivo .env (con llaves reales) a git.

# Verificacion del webhook (la defines tu mismo, cualquier cadena larga sirve)
VERIFY_TOKEN=

# Meta / Facebook Page
PAGE_ACCESS_TOKEN=
GRAPH_API_VERSION=v20.0

# OpenRouter (modelo de IA)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_REFERRER=https://example.com
OPENROUTER_TITLE=Bot Marketplace Vehiculos

# Notificacion de leads por WhatsApp via CallMeBot
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=

# WhatsApp de contacto que el bot ofrece al cliente al final del flujo
CONTACT_WHATSAPP_NUMBER=+12816027044

PORT=3000
